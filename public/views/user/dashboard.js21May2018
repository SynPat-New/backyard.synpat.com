	function leadTableRefresh(t){
		console.log("Refresh");
		jQuery("#newLeadFormElement").modal("hide");
		/*window.leadGlobal = t;		*/
		if(window.leadGlobal>0){
			_getLeadTableDeffer = leadTableData();
			_getLeadTableDeffer.done(function(){
				_leadDetails = leadCache[leadGlobal]['lead_table'];
				console.log("DONE");
