						jQuery("#from_litigation").find("#schedule1stCall").before(jQuery('#embed_code').val());
						jQuery('#create_scheduleCall').modal('hide');
					}  else {
						alert("Server busy. Refresh your page.");   
					}              
				}
			});
		} else {
			alert("Server busy. Refresh your page.");   
		}
		
	}
