window.embedTemplateMessage = function(data,textStatus,xhr){
	if(data!=""){
		if(typeof data.subject!="undefined"){
			jQuery("#CallPurpose").val(data.subject);
			jQuery("#td-subject").html(data.subject);
		}
		if(typeof data.template_html!="undefined"){
			jQuery("#predefined_template").code(data.template_html);
		}		
	}
}
function enableZIndex(o){
	if(typeof o=="object"){
		b=jQuery("body").data("modalzindex");
		if(typeof(b)=="undefined"){
			 b = 1053;
		 }
		e=parseInt(b)+1;
		o.css('z-index',e);
		jQuery("body").data("modalzindex",e);
	}
}

function getCallEvent(_nameUser,_p,_companyID){
	jQuery("#formCallInOut").get(0).reset();
	jQuery("#callInOutModalLabel").find('#callInOutLeadName').html(leadNameGlobal);
	jQuery("#callLeadId").val(leadGlobal);
	jQuery("#callMainActivity").val(jQuery("#activityMainType").val());
	jQuery("#callPerson").val(_p.substr(0,_p.length-1));	
	jQuery("#callCompanyID").val(_companyID.substr(0,_companyID.length-1));		
	/*Check which activity open*/
	stageName= "";
	_tableDetails = "";
	_companyName = "";
	_personName = "";
	_personTitle="";
	_phone="";
	_telephone="";
	_mainActivity = jQuery("#activityMainType").val();
	objParent= "";
	if(_mainActivity=="1"){
		objParent = "#activityTable";
	} else if(_mainActivity=="2"){
		objParent = "#aquisitionTable";
	}
	obj= jQuery(objParent).find('input[name="sales_person[]"]:checked').eq(0).parent().parent().parent().parent().parent().parent().prev();
	if(obj.hasClass('master')){
		stageName = obj.find('select[name="stage_progress"]').find('option:selected').attr('class');
		_companyName = obj.find('td').eq(1).find('a').eq(1).find('b').text();
		obj.next().find('tbody>tr.salesFDroppable').each(function(){
			if(jQuery(this).attr('data-p')==jQuery("#callPerson").val()){
				_personName = jQuery(this).find('td').eq(1).find('a').text();
				if(jQuery(this).find('td').eq(0).find('a').find('i.icon-phone').length>0){
					_atr = jQuery(this).find('td').eq(0).find('a').find('i.icon-phone').parent();
					if(_atr.attr('data-phone')!='undefined'&&_atr.attr('data-phone')!="" ){
						_phone = _atr.attr('data-phone');
					}
					if(_atr.attr('data-telephone')!='undefined'&&_atr.attr('data-telephone')!="" ){
						_telephone = _atr.attr('data-telephone');
					}
				}
				_personTitle = jQuery(this).find('td').eq(2).text();
			}
		});			
	}
	
	_textWith = "";
	if(_personName!=""){
		_textWith +=_personName;
	}
	if(_personTitle!=""){
		_textWith +=', '+_personTitle;
	}
	if(_companyName!=""){
		_textWith +=', '+_companyName;
	}
	jQuery("#callParticipant").val(_textWith);	
	jQuery("#td-with").html(_textWith);
	if(_phone!="" && _phone!='undefined' && _phone!=undefined){
		_phone = jQuery.trim(_phone);
		_phone = '<a class="btn btn-primary pull-right mrg5T mrg5L" href="javascript://" onclick=\'callFromLandline(encodeURIComponent("'+_phone+'"),2)\'><i class="glyph-icon icon-phone"></i> Work Phone</a>';
	}
	if(_telephone!="" && _telephone!='undefined' && _phone!=undefined){
		_telephone = jQuery.trim(_telephone);
		_telephone = '<a class="btn btn-primary pull-right mrg5T" href="javascript://" onclick=\'callFromLandline(encodeURIComponent("'+_telephone+'"),2)\'><i class="glyph-icon icon-phone"></i> Mobile Phone</a>';
	}
	switch(parseInt(jQuery("#activityMainType").val())){
		case 1:
			_emailLabel = "Email via Licenses@SynPat";
		break;
		case 2:
		default:
			_emailLabel = "Email via Patents@SynPat";
		break;
	}
	_personalButton = ""; 
	if(jQuery("#user_email").length>0){
		_email = jQuery("#user_email").val();
		if(_email.indexOf('synpat')>=0){
			_personalButton = "<button onclick='openPersonalEmailAccount();' type='button' class='btn btn-primary mrg5T mrg5L pull-right'><i class='glyph-icon icon-email'></i>Personal@SynPat</button>";
		}
	}
	_table = "<button onclick='openTaskModal()' type='button' class='btn btn-primary mrg5T pull-right mrg5L'><i class='glyph-icon icon-plus tooltip-button'></i>&nbsp;Task to Other</button><button onclick='openCalendarEvent()' type='button' class='btn btn-primary mrg5T pull-right mrg5L'><i class='glyph-icon icon-calendar tooltip-button' style='font-size:18px'></i></button>"+_personalButton+"<button onclick='openLicenseEmailAccount();' type='button' class='btn btn-primary mrg5T mrg5L pull-right'><i class='glyph-icon icon-email'></i> "+_emailLabel+"</button>"+_phone+_telephone;
	jQuery('#person-details-pop').html(_table);
	_w= jQuery(window).height();
	mainWIDTH = jQuery(window).width();
	_h1=100;
	_h2 = 130;
	switch(mainWIDTH){
		case 1024:
			_h1=100;
			_h2 = 130;
		break;
		default:
			nH = _w - 120 - 55 - 40 - 150;
			_h1=nH/2;
			_h2 = nH/2;
		break;
	}
	jQuery("#predefined_template").val('');
	jQuery("#predefined_template").destroy();
	$('#predefined_template').summernote({
		height: _h1,
		disableDragAndDrop: true,
		toolbar: [
			['style', ['bold', 'italic', 'underline', 'clear']],
			['fontsize', ['fontsize']],
			['color', ['color']],
			['para', ['ul', 'ol', 'paragraph']],
			['height', ['height']],
		],
		onChange: function() {saveAsInLeadScript(_mainActivity); } 
	});

	jQuery("#callNote").val('');
	jQuery("#callNote").destroy();
	initEditor('#callNote',_h2);
	if(stageName!=""){
		data = {st:stageName,lead:leadGlobal};
		call(__baseUrl+'users/find_message_template_stage','POST',data,embedTemplateMessage,'json');
	}
	
	openSlidebar(jQuery('#callInOutModal'),'','100','%');
	enableZIndex(jQuery('#callInOutModal'));
	/*jQuery('#callInOutModal').modal('show');
	jQuery('#callInOutModal').off('hidden.bs.modal').on('hidden.bs.modal',function(){
		jQuery('body').find('input[type="checkbox"]').prop('checked',false);
		jQuery('#activityType').val();
	});*/
	
	/*jQuery('#CallExecutionDate').datepicker("destroy");*/
	_da = moment(new Date()).tz('America/Los_Angeles').format('YYYY-MM-D h:mm:ss a');
	_date = new Date(_da);
	jQuery('#CallExecutionDate').datepicker({format:"yyyy-mm-dd"}).datepicker('setDate', _date);
	jQuery("#nextCallDate").datepicker('destroy');
	jQuery.datepicker.setDefaults({
		 dateFormat: 'yy-mm-dd'
	});	
	jQuery("#nextCallDate").datepicker();
	_hr = _date.getHours();
	_mn = _date.getMinutes();
	_height = _w - 120;
	jQuery('#callInOutModal').find('.modal-body').css('height',_height+'px');
	jQuery("#callTimeStart").val(_hr);
	jQuery("#callTimeEnd").val(_hr);
	_w = _w-50;
	jQuery("#callInOutModal").find('.slimScrollDiv').eq(0).css('height',_w+'px');
	_w = _w-80;
	jQuery("#callInOutModal").find('.slimScrollDiv').eq(1).css('height',_w+'px');
	getLogDetails(leadGlobal,_p.substr(0,_p.length-1),_companyID.substr(0,_companyID.length-1));
	/*jQuery("#company_calendar").html('<iframe src="'+__baseUrl+'users/company_calendar" style="width:100%;height:'+ _height+'px"></iframe>');*/
	/*users/company_calendar*/
	/*jQuery("#callTimeStart>option").each(function(){
		if(jQuery(this).attr('value')==_hr){
			jQuery(this).prop("selected",true);
		}
	});
	jQuery("#callTimeEnd>option").each(function(){
		if(jQuery(this).attr('value')==_mn){
			jQuery(this).prop("selected",true);
		}
	});*/
}

