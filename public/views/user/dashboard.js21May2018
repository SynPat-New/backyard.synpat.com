	function openEntireFamily(o){
		if(jQuery("#family_patent_container").hasClass('hide')){
			o.html('<i class="glyph-icon icon-folder-open" style="font-size:16px;"></i> Core Table');
			jQuery(".ppatent").addClass('hide').removeClass('show');
