			}
		}
	}
	_listA = [11,22];
	_listA.map(function(f){
		switch(f){
			case 11:
			case 22:
				if(f==11){
					var findFrame = jQuery("#open_sales_gd").find("iframe#salesFormIframe").contents();
					var findFrameJS = jQuery("#open_sales_gd").find("iframe#salesFormIframe").get(0);
