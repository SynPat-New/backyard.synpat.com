						jQuery('#'+fromType).find("#claim_illus").find('a').attr('onclick','claimIllus('+fromType+')');
					}
				}  else {
					alert(obj.message);   
					jQuery('#'+fromType).find("#loader_claim_illus_dd_market").hide();
					jQuery('#'+fromType).find("#claim_illus").find('a').attr('onclick','claimIllus("'+fromType+'")');
