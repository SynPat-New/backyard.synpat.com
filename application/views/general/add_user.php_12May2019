						}

					} else {

						jQuery("#pageUserID").multiSelect('deselect_all').multiSelect('refresh');

						$(".ms-container").find('i').remove();
							$(".ms-container").find('i').append('<i class="glyph-icon icon-exchange"></i>');

					}

				}

			});

		}

	}

