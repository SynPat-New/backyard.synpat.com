function GetEmailsFromString(input) {
	var ret = [];
	if(input.indexOf('<')>=0){
		var email = /<([^\>]+)\>/g
		var match;
		while (match = email.exec(input)){
			if(match[1]!=null){
			  ret.push(match[1]);
			}
		}
	} else {
	  ret.push(input);
	} 
	return ret;  
}
