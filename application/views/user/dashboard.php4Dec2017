	_todayDate = '<?php echo date('M/D/Y');?>';
	function updateMyDate(o){
		_date = o.val();
		if(_date!=""){
			if(moment(new Date(_date)).isValid()===true){
				lateLicense = moment(new Date(_date)).add(4,'months').format('MM/DD/YYYY');
				jQuery('#'+_mainButtonParentElement).find('#docketLateLicenseStarts').val(lateLicense);
				stage = 2;
				_todayDate = moment(new Date(_todayDate)).format('MM/DD/YYYY');				
				if(moment(new Date(_todayDate)).isAfter(lateLicense,'MM/DD/YYYY')===true){					
					stage = 3;
				}
				jQuery('#'+_mainButtonParentElement).find('#docketActiveButton').val(stage);
				switch(stage){
					case 2:
						jQuery('#'+_mainButtonParentElement).find('#stage').html('Regular Price: ');
					break;
					case 3:
						jQuery('#'+_mainButtonParentElement).find('#stage').html('Validated Price: ');
					break;
				}
				findSyndicatePrice();
			}
		} else {
			jQuery('#'+_mainButtonParentElement).find("#docketLateLicenseStarts").val('');
		}
	}
	
	function findSyndicatePrice(){
		call(__baseUrl+'leads/find_syndicate_price','POST',{l:leadGlobal},getSyndicatePrice,'json');
	}
	
	function getSyndicatePrice(data,textStatus,xhr){
		if(typeof data.cost_price!="undefined"){
			if(data.cost_price>0){
				regularPrice = data.cost_price * 1.5;
				validatedPrice = data.cost_price * 3;
				stage = jQuery('#'+_mainButtonParentElement).find('#docketActiveButton').val();
				switch(stage){
					case 2:
						jQuery('#'+_mainButtonParentElement).find('#stage').html('Regular Price: '+regularPrice);
					break;
					case 3:
						jQuery('#'+_mainButtonParentElement).find('#stage').html('Validated Price: '+validatedPrice);
					break;
				}
			}
		}
	}
</script>
