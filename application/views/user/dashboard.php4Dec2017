function showDataClickPrevent(){
	jQuery('#show_data div.tab-content').find('a').off('click');jQuery('#show_data div.tab-content').find('a').click(function(e){_href = jQuery(this).attr('href');if(_href.indexOf('http://')=='-1' && _href.indexOf('https://')=='-1'){_href = 'https://search.rpxcorp.com'+_href;}window.open(_href,'_blank');e.preventDefault();})
}
function openAllCompanies(){
	_ma = jQuery("#activityMainType").val();
	_container = "";
	if(_ma=="1"){
		_container ='activityTable';
	} else {
		_container ='aquisitionTable';
	}
	jQuery("#"+_container).find('tbody').find('tr.master').each(function(){
		if(toggleOPen==0){			
			jQuery(this).next().css('display','table-row');
		} else {
			jQuery(this).next().css('display','none');
		}
	});
	if(toggleOPen==0){	
		toggleOPen = 1;
	} else {
		toggleOPen = 0;
	}
}
