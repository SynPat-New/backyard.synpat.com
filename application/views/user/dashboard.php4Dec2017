	<script>
		var salesActivities = {'1':'Call In','2':'Call Out','37':'Conference Call','3':'Email Sent','4':'Send Letter','5':'LinkedIn Message','6':'Email Received','11':'Calendar Event','10':'Task','206':'Voice Mail'};
		$(function() { "use strict";
			$('.date_calendar').datepicker({
				format: 'yyyy-mm-dd'
			});
		});
		jQuery(document).ready(function(){
			jQuery(document).on('keypress',function(e){
				code = e.keyCode || e.which;				
				if(code===13 &&  jQuery("#table_search").is(':focus')){
					 e.preventDefault();
				}
			});
			jQuery("#table_search").on("keyup",function(e){
				
				var value = jQuery(this).val();
				value = value.toLowerCase();
				_mainActivity = jQuery("#activityMainType").val();
				_containerTable = "";
				switch(parseInt(_mainActivity)){
					case 1:
						_containerTable="activityTable";
					break;
					case 2:
						_containerTable="aquisitionTable";
					break;
				}
				jQuery("#"+_containerTable).find('table>tbody.main_active').find('tr.master').each(function(ind){
					$row = jQuery(this);
					_findVal = $row.find('td').eq(1).find('a').eq(1).find('b').text();
					_findVal = _findVal.toLowerCase();
					if(value.length>0){
						if(_findVal.indexOf(value)<0){
							$rowNext = $row.next();
							if($rowNext.find('table>tbody>tr.salesFDroppable').length>0){
								$rowNext.find('table>tbody>tr.salesFDroppable').each(function(){
									$rowNextRow = jQuery(this);
									_findNextVal = $rowNextRow.find('td').eq(1).find('a').text();
									_findNextVal = _findNextVal.toLowerCase();
									if(_findNextVal.indexOf(value)<0){
										$row.hide();
									} else {
										$row.show();
									}
								});
							} else {
								$row.hide();
							}
						} else {
							$row.show();
						}
					} else {
						$row.show();
					}
					/*if(_findVal.indexOf(value)!==0){
						console.log("1");
						$rowNext = $row.next();
						__hide = false;
						if($rowNext.find('table>tbody>tr.salesFDroppable').length>0){
							$rowNext.find('table>tbody>tr.salesFDroppable').each(function(){
								$rowNextRow = jQuery(this);
								_findNextVal = $rowNextRow.find('td').eq(1).find('a').text();
								_findNextVal = _findNextVal.toLowerCase();
								if(_findNextVal.indexOf(value)!==0){
									$row.hide();
								} else {
									$row.show();
								}
							});
						} else {
							$row.hide();
						}
					} else {		
						console.log("2");
