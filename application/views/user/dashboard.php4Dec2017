<script src="https://storage.googleapis.com/static.synpat.com/backyard/widgets/tablesorter/stupidtable.min.js"></script>
<script type="text/javascript" src="http://backyard.synpat.com/public/views/user/dashboard.js"></script>
<script>
	function moveEmails(){
		if(leadGlobal>0){
			if(jQuery('#displayEmail').find('iframe').length>0){
				_src = jQuery('#displayEmail').find('iframe').attr('src');
				_eID = _src.split('/').pop();
				_mainActivity = parseInt(jQuery("#activityMainType").val());
				if(parseInt(_eID) && _mainActivity>0){
					getAllLeadsPointing(_mainActivity,_eID);
				} else {
					alert("Please select person whom you want to assign email.");
				}
			} else {
				_table="";
				if(jQuery("#aquisitionTable").is(":visible")){
					_table = "#aquisitionTable";
				} else if(jQuery("#activityTable").is(":visible")){
					_table = "#activityTable";
				}
				if(_table!=""){
					if(jQuery(_table).find('tbody').length>0 && jQuery(_table).find('tbody').find('tr').find('td.active').length>0){
						if(jQuery(_table).find('tbody').find('tr').find('td.active').find('a').attr('data-tr')!=''){
							_mainActivity = parseInt(jQuery("#activityMainType").val());
							_eID = jQuery(_table).find('tbody').find('tr').find('td.active').find('a').attr('data-tr');
							getAllLeadsPointing(_mainActivity,parseInt(_eID));
						} else {
							alert("Please select email you want to move.");
						}
					} else {
						alert("Please select email you want to move.");
					}
				}else {
					alert("Please select email you want to move.");
				}
				
			}
		} else {
			alert("Please select lead first.");
		}
	}
</script>
</div>
<?php 
	$emailAuthorize=0;
	if((int)$this->session->userdata['user']['type']==9 || in_array(23,$this->session->userdata['modules_assign'])):
	$emailAuthorize=1;
	elseif(in_array(26,$this->session->userdata['modules_assign'])):
	$emailAuthorize=2;
	endif;
?>
<input type="hidden" name="email_authorize" id="email_authorize" value="<?php echo $emailAuthorize;?>"/>
