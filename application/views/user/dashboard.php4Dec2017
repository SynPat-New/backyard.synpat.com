function countActiveMenus(){
	_screenList =['Acquisition','Sales','Patents','Litigation','Emails','Lead Form','PreSale','Leads'];
	_screenListID = {Acquisition:'acquisitionActivityButton',Sales:'salesActivityButton',Patents:'btnPatentsAll',Litigation:'displayLitigationCampaign',Emails:'btnEmail','Lead Form':'btnFormCollapse'}
	activeMenus= [];
	modulesActive = 0;
	jQuery("#header-nav-right").find('li>a.menu-active').each(function(){
		if(jQuery.inArray(jQuery.trim(jQuery(this).text()),_screenList)>=0){
			activeMenus.push(jQuery.trim(jQuery(this).text()));
			modulesActive++;
		}
	});
	if(jQuery('a.menu-active1').length>0){
		if(jQuery.inArray('Emails',activeMenus)<0){
			activeMenus.push('Leads');
			modulesActive++;
		}
	}
	_staticHeight = parseInt(jQuery('#page-header').css('height'));
	deviceHeight = jQuery(window).height();
	heightAfterStatic = deviceHeight - _staticHeight;
	heightAfterStatic = heightAfterStatic-5;
	heightAssign = heightAfterStatic/modulesActive;
	
	for(i=0;i<activeMenus.length;i++){
		if(activeMenus[i]=="Acquisition"){	
			jQuery('#dashboard-page').css("height",'100%');
			jQuery("#sales_acititity").removeClass("hide").addClass('show');
			jQuery("#sales_acititity").css({height:heightAssign+'px',overflowX:'hidden',overflowY:'scroll'});
			
		}
		if(activeMenus[i]=="Litigation"){
			jQuery('#dashboard-page').css("height",'100%');
			jQuery("#sales_acititity").removeClass("show").addClass('hide');
			/*jQuery("#sales_acititity").css({height:heightAssign+'px',overflowX:'hidden',overflowY:'scroll'});*/
			navClick();	
			destoryAndReIntiate();
		}
		if(activeMenus[i]=="Sales"){
			jQuery('#dashboard-page').css("height",'100%');	
			jQuery("#sales_acititity").removeClass("hide").addClass('show');			
			jQuery("#sales_acititity").css({height:heightAssign+'px',overflowX:'hidden',overflowY:'scroll'});
			
		}
		if(activeMenus[i]=="PreSale"){
			jQuery('#dashboard-page').css("height",'100%');		
			jQuery("#sales_acititity").removeClass("hide").addClass('show');
			jQuery("#sales_acititity").css({height:heightAssign+'px',overflowX:'hidden',overflowY:'scroll'});
			
		}
		if(activeMenus[i]=="Patents"){
			jQuery('#dashboard-page').css("height",'100%');
			jQuery("#sales_acititity").addClass('hide').removeClass('show');
			jQuery('.openPatentDetail').removeClass('hide').addClass('show');
			jQuery("#patent_data").css({height:heightAssign+'px',overflowX:'hidden',overflowY:'auto'});
			h = heightAssign - 95;
			jQuery("#scrap_patent_data").DataTable().destroy();
			enablePatentCoreDT(jQuery("#scrap_patent_data"));
			if(jQuery("#family_patent_container").hasClass('show')){
				jQuery("#patent_family").DataTable().destroy();
				enablePatentCoreDT(jQuery("#patent_family"));
			}
			console.log("Element height Patent: "+heightAssign);
		}
		if(activeMenus[i]=="Lead Form"){
			console.log("Enter");
			jQuery('#dashboard-page').css("height",'100%');
			jQuery("#"+_mainBtnParentElement).css({height:heightAssign+'px',overflowX:'hidden',overflowY:'auto'});
			/*btnHeight = heightAssign - 127;*/
			btnHeight = heightAssign-171;			
			/*jQuery("#"+_mainBtnParentElement).find('#litigation_doc_list').css({minHeight:btnHeight+'px',height:btnHeight+'px',maxHeight:btnHeight+'px'});*/
			jQuery("#"+_mainBtnParentElement).find('#litigation_doc_list').css({minHeight:'230px',height:'230px',maxHeight:'230px'});
			btnHeight = 230 + 32;
			if(_mainBtnParentElement=="from_litigation"){
				btnHeight = btnHeight + 33;
			}
			jQuery("#"+_mainBtnParentElement).find('.todo-list-custom').css({minHeight:btnHeight+'px',height:btnHeight+'px',maxHeight:btnHeight+'px'});					
		}
		if(activeMenus[i]=="Emails" || activeMenus[i]=="Leads"){
			if(activeMenus[i]=="Emails"){
				/*jQuery('.emails-group-container').parent().css("height",heightAssign+'px');*/
				messageHeight = heightAssign - 2;
				jQuery('#messages-list').find('.mCustomScrollBox').css({minHeight:messageHeight+'px',maxHeight:messageHeight+'px'});
				if(jQuery('#messages-list').length==0){
					jQuery('#listMainContainerModif').css({minHeight:heightAssign+'px',maxHeight:heightAssign+'px'});
					jQuery('#listMainContainerModif,#listMainContainerModif div.panel-blue-border').css({minHeight:heightAssign+'px',maxHeight:heightAssign+'px'});
				}
				jQuery("#old_lead").css("height",heightAssign+'px');
				jQuery("#displayEmail").css("height",heightAssign+'px');
				if(jQuery("#displayEmail").find('#message-detail').length>0){
					jQuery("#displayEmail").find('#message-detail').css({minHeight:heightAssign+'px',maxHeight:heightAssign+'px'});
				}
				
				if(jQuery("#displayEmail").find('iframe').length>0){
					jQuery("#displayEmail").find('iframe').css("height",heightAssign+'px');
					_cont = jQuery("#displayEmail").find('iframe').get(0);
					jQuery(_cont.contentDocument).find('#message-detail').css({minHeight:heightAssign+'px',maxHeight:heightAssign+'px'});
				}			
				jQuery('#myEmailsRetrieve').css({minHeight:heightAssign+'px',maxHeight:heightAssign+'px'});
				if(jQuery('#myEmailsRetrieve').find('iframe').length>0){
					jQuery('#myEmailsRetrieve').find('iframe').css("height",heightAssign+'px');
				}		
				if(jQuery("#split_window_screen").hasClass('menu-active1')){
					jQuery('#messages-boxlist > div').css('height', (heightAssign - 2) + 'px');
					jQuery('#all_type_list_wrapper > .DTFC_ScrollWrapper').css('height', (heightAssign - 3) + 'px');
					jQuery('#all_type_list_wrapper .dataTables_scrollBody').css('height', (heightAssign - 32) + 'px');
					jQuery('#all_type_list_wrapper .DTFC_LeftBodyWrapper').css('height', (heightAssign - 48) + 'px');
					jQuery('#all_type_list_wrapper .DTFC_LeftBodyLiner').css('height', (heightAssign - 48) + 'px');
					splitWindow(3);
				} else {
					console.log('Not Active');
					splitWindow(1);
				}
			} else if(activeMenus[i]=="Leads"){
				console.log('Allow to come in');
				jQuery('#myEmailsRetrieve').css({minHeight:heightAssign+'px',maxHeight:heightAssign+'px'});
				if(jQuery('#myEmailsRetrieve').find('iframe').length>0){
					jQuery('#myEmailsRetrieve').find('iframe').css("height",heightAssign+'px');
				}
				jQuery("#old_lead").css("height",heightAssign+'px');
				jQuery('#messages-boxlist > div').css('height', (heightAssign - 2) + 'px');
				jQuery('#all_type_list_wrapper > .DTFC_ScrollWrapper').css('height', (heightAssign - 3) + 'px');
				jQuery('#all_type_list_wrapper .dataTables_scrollBody').css('height', (heightAssign - 32) + 'px');
				jQuery('#all_type_list_wrapper .DTFC_LeftBodyWrapper').css('height', (heightAssign - 48) + 'px');
				jQuery('#all_type_list_wrapper .DTFC_LeftBodyLiner').css('height', (heightAssign - 48) + 'px');				
				/*jQuery("#all_type_list_wrapper .sorting:first").trigger("click");*/
			}
		}
	}
	if(activeMenus.length==1 && activeMenus[0]=="Leads"){
		jQuery("#old_lead").parent().css('margin-left','5px');
	} else {
		jQuery("#old_lead").parent().css('margin-left','0px');
	}
}
